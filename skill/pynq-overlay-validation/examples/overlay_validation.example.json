{
  "schema": "pynq-overlay-validation-contract-v1",
  "project": "replace_with_project_name",
  "overlay": {
    "bit": "overlay/design.bit",
    "hwh": "overlay/design.hwh",
    "bit_sha256": "replace_with_sha256",
    "hwh_sha256": "replace_with_sha256",
    "download": true
  },
  "required_ip": [
    {
      "pattern": "^axi_dma_0$",
      "expected_type_pattern": "axi_dma",
      "minimum_matches": 1
    }
  ],
  "register_checks": [],
  "adapter": "adapter.py",
  "adapter_config": {
    "dma_ip": "axi_dma_0",
    "input_key": "input",
    "output_key": "output"
  },
  "test": {
    "input_npz": "vectors/input.npz",
    "golden_npz": "vectors/golden.npz",
    "warmup": 2,
    "repeats": 10,
    "timeout_seconds": 30.0,
    "comparison": {
      "exact": false,
      "rtol": 1e-05,
      "atol": 1e-07
    }
  }
}
